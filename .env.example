PORT=4199
PUBLIC_URL=http://127.0.0.1:4199

# Optional Stripe Checkout setup.
# Use Stripe test mode keys while developing.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID_PREMIUM=price_xxx
STRIPE_API_VERSION=2026-02-25.clover

# Optional for production-grade webhook verification later.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional Resend transactional email setup.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Trend-Spotter <hello@trendspotter.com>

# Optional Supabase database setup.
# Keep this key server-side only. Never expose it in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_secret_key
